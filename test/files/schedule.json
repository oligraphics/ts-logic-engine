{
  "id": "test:schedule",
  "context": {
    "#start-message": "Schedule started!",
    "#update-message": "Update!",
    "#stop-message": "Schedule done!",
    "#cancel-message": "Schedule cancelled!"
  },
  "actions": {
    "main": {
      "type": "compound",
      "apply": {
        "compound": [
          "cancel-timer",
          "schedule"
        ]
      }
    },
    "cancel-timer": {
      "type": "schedule",
      "apply": {
        "schedule": [
          {
            "action": "cancel",
            "delay": 2500
          }
        ]
      }
    },
    "cancel": {
      "type": "message",
      "apply": {
        "message": "Cancel"
      }
    },
    "schedule": {
      "type": "schedule",
      "apply": {
        "schedule": [
          {
            "action": "start-message"
          },
          {
            "action": "update-message",
            "delay": 1000,
            "every": 1000,
            "times": 4
          },
          {
            "action": "stop-message",
            "delay": 5000
          }
        ],
        "cancel": {
          "event": "message",
          "phase": "performed",
          "filter": {
            "type": "equal",
            "value": "{event.message}",
            "equals": "Cancel"
          }
        },
        "cancelled": {
          "next": "cancel-message"
        }
      }
    },
    "start-message": {
      "type": "message",
      "apply": {
        "message": "#start-message"
      }
    },
    "update-message": {
      "type": "message",
      "apply": {
        "message": "#update-message"
      }
    },
    "stop-message": {
      "type": "message",
      "apply": {
        "message": "#stop-message"
      }
    },
    "cancel-message": {
      "type": "message",
      "apply": {
        "message": "#cancel-message"
      }
    }
  }
}