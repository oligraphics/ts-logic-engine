{
  "id": "test:schedule",
  "context": {
    "#start-message": "Schedule started!",
    "#update-message": "Update!",
    "#stop-message": "Schedule done!"
  },
  "actions": {
    "main": {
      "type": "schedule",
      "apply": {
        "schedule": [
          {
            "action": "start-message"
          },
          {
            "action": "update-message",
            "delay": 1000,
            "every": 1000,
            "times": 4
          },
          {
            "action": "stop-message",
            "delay": 5000
          }
        ]
      }
    },
    "start-message": {
      "type": "message",
      "apply": {
        "message": "#start-message"
      }
    },
    "update-message": {
      "type": "message",
      "apply": {
        "message": "#update-message"
      }
    },
    "stop-message": {
      "type": "message",
      "apply": {
        "message": "#stop-message"
      }
    }
  }
}